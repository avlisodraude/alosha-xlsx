{
  "name": "@alosha/xlsx",
  "version": "0.14.0",
  "description": "A modern TypeScript library for reading and writing XLSX spreadsheets, inspired by exceljs.",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "ooxml",
    "workbook",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "author": "E.Y. Silva Navarrete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avlisodraude/alosha-xlsx.git"
  },
  "homepage": "https://xlsx.alosha.dev",
  "bugs": "https://github.com/avlisodraude/alosha-xlsx/issues",
  "type": "module",
  "sideEffects": [
    "./dist/*.js",
    "./dist/*.cjs",
    "./dist-browser/*.js",
    "./dist-browser/*.cjs"
  ],
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist-browser/index.d.ts",
          "default": "./dist-browser/index.js"
        },
        "require": {
          "types": "./dist-browser/index.d.cts",
          "default": "./dist-browser/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compat": {
      "browser": {
        "import": {
          "types": "./dist-browser/compat.d.ts",
          "default": "./dist-browser/compat.js"
        },
        "require": {
          "types": "./dist-browser/compat.d.cts",
          "default": "./dist-browser/compat.cjs"
        }
      },
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dist-browser",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node --import tsx tests/package-smoke.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/index.ts",
    "bench:stream": "tsx bench/streaming.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "exceljs": "^4.4.0",
    "esbuild": "0.27.7",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
